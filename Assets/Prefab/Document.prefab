--- !u!114 &6180959954938266120
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2927131328433464734}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "RAPPORT DE D\xC9CONTAMINATION \u2013 CLASSIFI\xC9\n\nUnit\xE9 : \xC9quipe
    Delta-7\nZone : Secteur C \u2013 Installation [Donn\xE9es corrompues]\nDate :
    \u2588\u2588 / \u2588\u2588 / \u2588\u2588\u2588\u2588\nStatut : \xC9CHEC \u2013
    ZONE INTERDITE\n\nLors de l\u2019intervention initiale, l\u2019\xE9quipe Delta-7
    a \xE9t\xE9 envoy\xE9e pour une proc\xE9dure standard de d\xE9contamination biologique
    suite \xE0 une fuite signal\xE9e dans le Secteur C.\n\nLa substance observ\xE9e
    ne correspond \xE0 aucun agent chimique ou biologique connu.\nAu bout de plusieurs
    minutes, le sujet contamin\xE9 a montr\xE9 :\n\nUne augmentation anormale de
    la force physique\nUne alt\xE9ration compl\xE8te du comportement\nUne perte totale
    de conscience individuelle\n\nLa substance semble imiter la morphologie humaine,
    reformant une silhouette humano\xEFde tout en conservant des mouvements non naturels.\n\n\xC0
    03:17, le contact radio avec l\u2019\xE9quipe a \xE9t\xE9 perdu.\nLes cam\xE9ras
    de surveillance montrent une entit\xE9 humano\xEFde quittant la zone \xE0 pied.\n\nAucun
    survivant confirm\xE9."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
